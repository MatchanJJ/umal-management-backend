{
  "name": "umal-management",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n next,api -c blue,magenta \"next dev --port 3000\" \"wrangler pages dev --port 8788\"",
    "build": "next build",
    "preview": "next build && wrangler pages dev out --port 8788",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tests/api",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
